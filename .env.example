# Copia este archivo a .env y completa los valores reales.
# .env nunca se versiona (ver .gitignore); config.json tampoco.
# Ausencia de una variable requerida por el proveedor activo = fallo inmediato
# al arrancar, no un default silencioso (ver sdd/integrations/providers.py).

# Selecciona el proveedor: anthropic (default) | openai | deepseek | qwen | glm | kimi
SDD_PROVIDER=anthropic

# Modelo a usar. Si se omite, cada proveedor aplica su propio default.
SDD_MODEL=claude-opus-5

# --- anthropic ---
ANTHROPIC_API_KEY=sk-ant-...

# --- openai (proveedor generico compatible con la API de OpenAI) ---
# SDD_API_KEY=...
# SDD_BASE_URL=https://api.openai.com/v1

# --- presets compatibles con OpenAI: cada uno usa su propia variable de key ---
# DEEPSEEK_API_KEY=...
# DASHSCOPE_API_KEY=...
# ZHIPUAI_API_KEY=...
# MOONSHOT_API_KEY=...

# Puerto del panel web (sdd web). Default: 8770
# SDD_PORT=8770
